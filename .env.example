# Puerto donde levanta Flask
PORT=5001

# Conexion a PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/trading

# Credenciales de acceso a la interfaz web
LOGIN_USER=admin
LOGIN_PASS=elegi_una_password

# Clave de sesion de Flask (string aleatorio largo, ej: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=string_aleatorio_largo

# Switch unico para AMBOS brokers: true = Binance testnet + cTrader demo, false = ambos reales
DEMO=true

# Binance Futures produccion (se usan con DEMO=false)
BINANCE_API_KEY=tu_api_key
BINANCE_API_SECRET=tu_api_secret

# Binance Futures testnet (se usan con DEMO=true) 
BINANCE_TESTNET_API_KEY=tu_api_key_de_testnet
BINANCE_TESTNET_API_SECRET=tu_api_secret_de_testnet

# Aplicacion de cTrader Open API (mismas credenciales para demo y real)
CTRADER_CLIENT_ID=tu_client_id
CTRADER_CLIENT_SECRET=tu_client_secret

# Cuenta demo de cTrader (se usa con DEMO=true)
CTRADER_ACCESS_TOKEN_DEMO=tu_access_token_demo
CTRADER_REFRESH_TOKEN_DEMO=tu_refresh_token_demo
CTRADER_ACCOUNT_ID_DEMO=tu_ctid_trader_account_id_demo

# Cuenta real de cTrader (se usa con DEMO=false)
# El access token vence a los 30 dias; el refresh token lo renueva solo (se guarda en ctrader_token_live.json)
CTRADER_ACCESS_TOKEN=tu_access_token
CTRADER_REFRESH_TOKEN=tu_refresh_token
CTRADER_ACCOUNT_ID=tu_ctid_trader_account_id
